NODE_ENV=development
PORT=4000
# Listen address. Unset: localhost in development, 0.0.0.0 in production.
# HOST=0.0.0.0
# fatal | error | warn | info | debug (debug also logs every request in development)
LOG_LEVEL=info
# Reverse-proxy hops in front of the API (nginx = 1, load balancer + nginx = 2). 0 only in local dev:
# production refuses 0, because behind a proxy every user would share one IP for rate limits.
TRUST_PROXY=0
# Public origin of the web app; used for CORS, Origin checks and links in emails/SMS.
APP_URL=http://localhost:5173
# API connects as app_user (RLS enforced). Migrations + worker use the owner role.
DATABASE_URL=postgres://app_user:app_user@localhost:5433/fixloop
DATABASE_OWNER_URL=postgres://owner:owner@localhost:5433/fixloop
DB_POOL_MAX=10
S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_BUCKET=fixloop-dev
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio-secret
S3_FORCE_PATH_STYLE=true
# log | postmark (production requires postmark)
EMAIL_PROVIDER=log
POSTMARK_TOKEN=
EMAIL_FROM=notifications@example.com
# log | twilio
SMS_PROVIDER=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
# Have I Been Pwned k-anonymity check on new passwords (true|false). Fails open on network errors.
PASSWORD_BREACH_CHECK=true
